# Local virtual environments
.venv/
venv/
env/

# Python build artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# IDE / OS
.idea/
.vscode/
.DS_Store

# Secrets — must NEVER be baked into the image. .env.example is fine.
.env
.env.*
!.env.example

